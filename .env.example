# Pinnacle AI — environment template.
# Copy to `.env` (git-ignored) for local `vercel dev` / `netlify dev`, and set
# the same values in your host's dashboard (Vercel/Netlify -> Environment vars).
# EVERYTHING HERE IS FREE. No Anthropic, no paid keys.

# ===========================================================================
# 1) The tutor brain — set ANY ONE (or more) of these free LLM providers.
#    The app tries them in order and falls through if one is rate-limited.
#    You do NOT need all of them; one free key is enough to go live.
# ===========================================================================

# Groq — fastest, best free quality. Get a key (no card): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile      # default; or llama-3.1-8b-instant (faster)

# Google Gemini — free, strong at math. Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Cerebras — free, very fast. Key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — one key, many free models. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# GitHub Models — free, reliable. Create a token (classic or fine-grained) with
# the "models: read" permission: https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=
# GITHUB_MODEL=openai/gpt-4o-mini

# Ollama — the keyless brain. 100% offline, no key. Set the URL to turn it on.
# Install + pull a model with scripts/setup-ollama.ps1.
#
#   LOCAL DEV: plain `vite` + scripts/ollama-dev-server.mjs already routes the
#   tutor to Ollama on :3002 — you do NOT need to set this for local dev.
#   Set it only for `vercel dev`, or to use Ollama as a cloud fallback:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b-instruct
#
#   PRODUCTION keyless brain: a DEPLOYED site cannot reach your localhost. To let
#   the live site stream from your own GPU, expose Ollama with a free tunnel:
#     powershell -ExecutionPolicy Bypass -File scripts\tunnel-ollama.ps1
#   then set OLLAMA_BASE_URL to the printed https URL + /v1 and put ollama first:
# OLLAMA_BASE_URL=https://your-tunnel.trycloudflare.com/v1
# AI_PROVIDER_ORDER=ollama,groq,gemini,cerebras,openrouter,github

# Optional global tuning
# AI_PROVIDER_ORDER=groq,openrouter,github,gemini,cerebras,ollama
# AI_MAX_TOKENS=4096
# AI_TEMPERATURE=0.6

# ===========================================================================
# 2) The database — Supabase (free Postgres). OPTIONAL.
#    Without these, the app runs on localStorage exactly as before.
#    Create a free project at https://supabase.com, run supabase/schema.sql,
#    then copy Project Settings -> API -> URL and anon/public key here.
#    NOTE: these are VITE_ prefixed because they're read in the browser.
# ===========================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
